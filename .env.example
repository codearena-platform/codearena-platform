# Copy to .env and replace the values before running docker compose.
# Generate a JWT secret:        openssl rand -hex 32
# Generate an encryption key:   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTER_KEY=replace-with-64-hex-characters

POSTGRES_PASSWORD=replace-with-a-random-password

# Optional migration controls (leave unset for normal startup):
# IAM_MIGRATION_DRY_RUN=true
# IAM_MIGRATION_ROLLBACK=001
