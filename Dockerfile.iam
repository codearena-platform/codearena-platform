FROM golang:1.25-alpine AS builder

WORKDIR /app
COPY codearena-core ./codearena-core
COPY codearena-platform ./codearena-platform
WORKDIR /app/codearena-platform
RUN go mod download

RUN CGO_ENABLED=0 GOOS=linux go build -o iam ./cmd/iam

# Final Stage
FROM alpine:latest

WORKDIR /root/

COPY --from=builder /app/codearena-platform/iam .
RUN mkdir -p docs

EXPOSE 7000

CMD ["./iam"]
