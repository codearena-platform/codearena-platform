# Pinned base images and buildvcs=false keep the manifest digest reproducible.
FROM golang:1.25-alpine@sha256:1ae0735f00daffa3aaf1363a5184c0d2dc55c78e3db4ec70241cdac97bf84b59 AS builder

WORKDIR /app
COPY codearena-core ./codearena-core
COPY codearena-platform ./codearena-platform
WORKDIR /app/codearena-platform
RUN go mod download

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=false -o iam ./cmd/iam

# Final Stage
FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc

WORKDIR /root/

COPY --from=builder /app/codearena-platform/iam .
RUN mkdir -p docs

EXPOSE 7000

CMD ["./iam"]
